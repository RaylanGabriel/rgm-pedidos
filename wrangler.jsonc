// Cloudflare Workers (Next.js via @opennextjs/cloudflare). Plano: docs/ARQUITETURA-CLOUDFLARE.md
//
// Dois Workers, cada um com seus segredos (`wrangler secret put ... [--env preview]`):
// - rgm-pedidos          → produção (banco Neon `production`, Pix real)
// - rgm-pedidos-preview  → testes/branches (banco Neon `preview`, Pix de teste)
//
// Aqui ficam só valores públicos. Segredos (DATABASE_URL, MP_CLIENT_SECRET, MP_TOKEN_KEY, ...) nunca entram neste arquivo.
// Atenção: "routes" É herdado (por isso o preview zera); "vars", "services" e "r2_buckets" NÃO são herdados pelo env "preview" — mantenha os dois blocos alinhados.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rgm-pedidos",
  // worker.ts = Worker gerado pelo OpenNext (.open-next/worker.js) + o handler do cron
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Domínio próprio: a zona rgm.dev.br está na Cloudflare com registros AAAA 100:: (com proxy) para @ e *.
  // A rota * cobre painel, www e todas as lojas; fotos.rgm.dev.br é domínio do bucket R2 (não passa pelo Worker).
  "routes": [
    { "pattern": "rgm.dev.br/*", "zone_name": "rgm.dev.br" },
    { "pattern": "*.rgm.dev.br/*", "zone_name": "rgm.dev.br" },
  ],
  "workers_dev": true,
  "preview_urls": true,
  // Manutenção a cada 5 min (lib/maintenance.ts) e backup diário às 06:00 UTC = 03:00 Brasília (lib/backup.ts).
  // Precisa do segredo CRON_SECRET no Worker. Herdado pelo preview (que roda no banco de testes).
  "triggers": { "crons": ["*/5 * * * *", "0 6 * * *"] },

  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "rgm-pedidos" }],
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "rgm-pedidos-fotos" },
    // Backup diário: bucket PRIVADO (sem endereço público), apaga sozinho o que tem mais de 30 dias
    { "binding": "BACKUPS", "bucket_name": "rgm-pedidos-backups" },
  ],
  "vars": {
    "ROOT_DOMAIN": "rgm.dev.br",
    "SITE_URL": "https://painel.rgm.dev.br",
    "MP_REDIRECT_URI": "https://painel.rgm.dev.br/admin/mercado-pago/retorno",
    "MP_TEST_MODE": "false",
    "FOTOS_PUBLIC_URL": "https://fotos.rgm.dev.br",
    // Turnstile (anti-robô no login do painel; tirado do checkout em 13/nov): widget "RGM Pedidos" (rgm.dev.br, modo Gerenciado). Chave pública;
    // o segredo TURNSTILE_SECRET_KEY fica no Worker. Vazio = desligado.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF--m8IBn58aOCqr",
  },

  "env": {
    "preview": {
      "name": "rgm-pedidos-preview",
      // "routes" é herdado: vazio de propósito para o preview nunca responder no domínio de produção
      "routes": [],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "rgm-pedidos-preview" }],
      // Bucket separado: um teste nunca apaga foto de loja real
      "r2_buckets": [
        { "binding": "FOTOS", "bucket_name": "rgm-pedidos-fotos-preview" },
        { "binding": "BACKUPS", "bucket_name": "rgm-pedidos-backups-preview" },
      ],
      "vars": {
        // Vazios de propósito: lojas pelo caminho /loja/<slug> e links com o endereço de acesso (*.workers.dev)
        "ROOT_DOMAIN": "",
        "SITE_URL": "",
        "MP_REDIRECT_URI": "https://painel.rgm.dev.br/admin/mercado-pago/retorno",
        "MP_TEST_MODE": "true",
        // Endereço público r2.dev do bucket de preview (só para testes: tem limite de acessos)
        "FOTOS_PUBLIC_URL": "https://pub-7178be0af245478695ef3fdfe20096af.r2.dev",
        // Chave de TESTE oficial da Cloudflare (sempre passa); o segredo de teste correspondente está no Worker
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
      },
    },
  },
}
