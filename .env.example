# Copie para .env.local e preencha. Nunca faça commit de valores reais.

# String de conexão do Neon (painel do Neon > Connection Details, com sslmode=require)
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Endereço público do painel (links e QR codes)
SITE_URL=http://localhost:3000

# Upload de fotos (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Mercado Pago (aplicação com Checkout Transparente + OAuth)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_REDIRECT_URI=http://localhost:3000/admin/mercado-pago/retorno
# Chave de 32 bytes em base64 para criptografar os tokens das lojas:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MP_TOKEN_KEY=
# Modo de teste: Pix de mentira, aprovados sozinhos
MP_TEST_MODE=true
MP_TEST_ACCESS_TOKEN=
